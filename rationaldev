#!/usr/bin/env sh
# rationaldev — управление self-updating харнесом (как omz/flutter).
#   rationaldev update    # git pull --ff-only канонического клона; проекты видят обновление через dir-symlinks (T2)
#
# Канонический клон — $RATIONALDEV_HOME (дефолт ~/.rationaldev); если скрипт лежит В клоне, берём его корень.
# Канал — $RATIONALDEV_CHANNEL (дефолт main): можно закрепиться на релиз-теге/ветке (flutter channels).
# ИНВАРИАНТ pristine-клона: клон потребляется read-only; локальные правки → апдейт отменяется (не клоббрим).
set -eu

SELF="$(cd "$(dirname "$0")" && pwd)"
# Приоритет: явный $RATIONALDEV_HOME > клон, в котором лежит скрипт > дефолт ~/.rationaldev.
if [ -n "${RATIONALDEV_HOME:-}" ]; then HOME_DIR="$RATIONALDEV_HOME"
elif [ -d "$SELF/.git" ]; then HOME_DIR="$SELF"
else HOME_DIR="$HOME/.rationaldev"; fi
CHANNEL="${RATIONALDEV_CHANNEL:-main}"

# Детект логин-оболочки → ровно один из zsh|bash|fish|other (дублируется с bootstrap.sh — норма для двух sh-скриптов).
# Приоритет: $RATIONALDEV_SHELL override > basename $SHELL > `ps -p $PPID -o comm=` (снять ведущий '-') > sh.
rd_detect_shell() {
  _sh="${RATIONALDEV_SHELL:-}"
  if [ -z "$_sh" ] && [ -n "${SHELL:-}" ]; then _sh="$(basename "$SHELL")"; fi
  if [ -z "$_sh" ]; then
    _c="$(ps -p "$PPID" -o comm= 2>/dev/null | sed 's/^-//' || true)"
    [ -n "$_c" ] && _sh="$(basename "$_c")"
  fi
  [ -z "$_sh" ] && _sh="sh"
  case "$_sh" in
    zsh)  echo zsh ;;
    bash) echo bash ;;
    fish) echo fish ;;
    *)    echo other ;;
  esac
}

update() {
  [ -d "$HOME_DIR/.git" ] || { echo "rationaldev: нет git-клона в $HOME_DIR (сначала bootstrap — см. backlog T1)"; exit 1; }
  # pristine: любые локальные правки (в т.ч. незакоммиченный models.config) → abort, чтобы ff-pull не конфликтовал
  if [ -n "$(git -C "$HOME_DIR" status --porcelain)" ]; then
    echo "rationaldev: клон $HOME_DIR не чист — апдейт отменён (pristine-инвариант)."
    echo "  верни клон в чистое состояние; кастомизацию держи в локальном override ВНЕ клона (models.config → T5)."
    exit 1
  fi
  before="$(git -C "$HOME_DIR" rev-parse --short HEAD)"
  git -C "$HOME_DIR" fetch --quiet origin "$CHANNEL" || { echo "rationaldev: git fetch не удался (offline?) — пропуск."; exit 0; }
  if ! git -C "$HOME_DIR" merge --ff-only "origin/$CHANNEL" >/dev/null 2>&1; then
    echo "rationaldev: не fast-forward (клон разошёлся с origin/$CHANNEL) — апдейт отменён (pristine-инвариант)."; exit 1
  fi
  after="$(git -C "$HOME_DIR" rev-parse --short HEAD)"
  if [ "$before" = "$after" ]; then
    echo "rationaldev: уже актуально ($after, канал $CHANNEL)."
  else
    n="$(git -C "$HOME_DIR" rev-list --count "$before..$after" 2>/dev/null || echo '?')"
    echo "rationaldev: обновлено $before → $after ($n коммитов, канал $CHANNEL). Проекты подхватят через dir-symlinks."
  fi
}

# --- T4: периодический авто-апдейт (flutter/omz-стиль) ------------------------
# Состояние (метка последней проверки) — ВНЕ клона (клон pristine): $RATIONALDEV_STATE.
# Режим $RATIONALDEV_UPDATE=auto|notify|off (дефолт notify); интервал $RATIONALDEV_UPDATE_DAYS (дефолт 1).
# Вызывается на СТАРТЕ сессии (opencode-плагин/claude-хук), throttled — не на каждый ход.
state_dir() { echo "${RATIONALDEV_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/rationaldev}"; }
# mtime файла. GNU `stat -c %Y` СНАЧАЛА (на macOS падает чисто → BSD `stat -f %m`).
# Обратный порядок ломается на Linux: GNU `stat -f` = статус ФС (не формат!) и «успешно» печатает мусор.
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

# git fetch с ТАЙМАУТОМ (портативно, без `timeout` — его нет на macOS): фон + kill. КРИТИЧНО — иначе
# на изолированной сети `git fetch` до non-routable origin висит минутами и вешает вызывающего (хук/шелл).
fetch_timeout() {
  git -C "$HOME_DIR" fetch --quiet origin "$CHANNEL" 2>/dev/null &
  fp=$!; i=0; lim="${RATIONALDEV_FETCH_TIMEOUT:-8}"
  while kill -0 "$fp" 2>/dev/null; do
    i=$((i+1))
    if [ "$i" -ge "$lim" ]; then
      kill "$fp" 2>/dev/null; for c in $(pgrep -P "$fp" 2>/dev/null); do kill "$c" 2>/dev/null; done
      return 1     # таймаут → считаем offline
    fi
    sleep 1
  done
  wait "$fp" 2>/dev/null
}

autocheck() {
  mode="${RATIONALDEV_UPDATE:-notify}"; [ "$mode" = off ] && return 0
  [ -d "$HOME_DIR/.git" ] || return 0
  days="${RATIONALDEV_UPDATE_DAYS:-1}"; sd="$(state_dir)"; stamp="$sd/last-update-check"
  if [ -f "$stamp" ]; then
    age=$(( $(date +%s) - $(mtime "$stamp") ))
    [ "$age" -lt $(( days * 86400 )) ] && return 0     # throttle: рано проверять
  fi
  mkdir -p "$sd"; : > "$stamp"                          # отметили проверку до fetch (offline/timeout не долбит)
  fetch_timeout || return 0                            # offline/изолированная сеть → тихо, НЕ висим
  behind="$(git -C "$HOME_DIR" rev-list --count "HEAD..origin/$CHANNEL" 2>/dev/null || echo 0)"
  [ "${behind:-0}" -gt 0 ] || return 0
  case "$mode" in
    auto)   echo "rationaldev: auto-update ($behind коммит(ов))"; update ;;   # ff-pull, pristine-guard внутри
    notify) echo "rationaldev: доступно обновление — $behind коммит(ов) в origin/$CHANNEL. Запусти: rationaldev update" ;;
  esac
}

# --- install: подключить репо к каноническому клону (dir-symlinks через install.sh) --------
# `rationaldev install <path-to-repo> [claude|opencode|codex]` — раннер авто-детектится по .claude/.opencode.
install_repo() {
  target="${1:-}"
  [ -n "$target" ] || { echo "usage: rationaldev install <path-to-repo> [claude|opencode|codex]"; exit 1; }
  [ -d "$target" ] || { echo "rationaldev: нет каталога '$target'"; exit 1; }
  [ -f "$HOME_DIR/install.sh" ] || { echo "rationaldev: $HOME_DIR/install.sh не найден — сначала bootstrap (curl … | sh)"; exit 1; }
  runner="${2:-}"
  if [ -z "$runner" ]; then
    if [ -d "$target/.claude" ]; then runner=claude
    elif [ -d "$target/.opencode" ]; then runner=opencode
    else runner=opencode; fi   # дефолт
  fi
  echo "rationaldev: подключаю $target ($runner) к клону $HOME_DIR"
  sh "$HOME_DIR/install.sh" "$runner" "$target" --hard --no-input
}

# --- doctor: диагностика здоровья установки (как `brew doctor`) — печатает, НЕ чинит ------------------------
# `rationaldev doctor [project-dir]` (дефолт — cwd). Зелёный/красный по каждому пункту; красный → точная
# команда починки. Ненулевой код выхода, если хоть один красный (для CI/смоука).
doctor() {
  proj="${1:-$(pwd)}"; red=0
  if [ -t 1 ]; then G="$(printf '\033[32m')"; R="$(printf '\033[31m')"; Z="$(printf '\033[0m')"; else G=""; R=""; Z=""; fi
  ok()   { printf '  %s✓%s %s\n' "$G" "$Z" "$1"; }
  bad()  { red=$((red+1)); printf '  %s✗%s %s\n' "$R" "$Z" "$1"; printf '      починка: %s\n' "$2"; }

  echo "rationaldev doctor — клон $HOME_DIR · проект $proj"

  # node / git присутствуют
  if command -v node >/dev/null 2>&1; then ok "node: $(node -v 2>/dev/null)"; else bad "node не найден" "установи Node >= 18 (https://nodejs.org)"; fi
  if command -v git  >/dev/null 2>&1; then ok "git: $(git --version 2>/dev/null | awk '{print $3}')"; else bad "git не найден" "установи git"; fi

  # клон чист (иначе `rationaldev update` откажет)
  if [ -d "$HOME_DIR/.git" ]; then
    if [ -z "$(git -C "$HOME_DIR" status --porcelain 2>/dev/null)" ]; then ok "клон pristine — update пройдёт"
    else bad "клон $HOME_DIR НЕ чист — update откажет (pristine-guard)" "git -C \"$HOME_DIR\" checkout -- harness/agents skills/roles harness/models.config.json  (кастомные модели держи в RATIONALDEV_MODELS вне клона)"; fi
  else bad "нет git-клона в $HOME_DIR" "bootstrap: sh -c \"\$(curl -fsSL <repo-raw>/bootstrap.sh)\""; fi

  # override моделей на месте и резолвится
  ov="${RATIONALDEV_MODELS:-}"
  if [ -n "$ov" ] && [ -f "$ov" ]; then
    if node -e 'JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"))' "$ov" 2>/dev/null; then
      ok "override моделей резолвится ($ov)"
    else bad "override моделей — битый JSON ($ov)" "почини JSON или удали файл (харнес вернётся к клон-дефолту)"; fi
  elif [ -n "$ov" ]; then bad "RATIONALDEV_MODELS указывает на несуществующий файл ($ov)" "создай его (configure-models) или сними переменную — будет клон-дефолт"
  else ok "override не задан — клон-дефолт моделей (ok)"; fi

  # runner проекта + живость симлинков + settings
  if [ -d "$proj/.claude" ]; then rn=claude; adir="$proj/.claude/agents"; sdir="$proj/.claude/skills"
  elif [ -d "$proj/.opencode" ]; then rn=opencode; adir="$proj/.opencode/agent"; sdir="$proj/.opencode/skills"
  elif [ -d "$proj/.agents" ]; then rn=codex; adir="$proj/.agents/roles"; sdir="$proj/.agents/skills"
  else rn=""; fi

  if [ -z "$rn" ]; then
    echo "  · в $proj харнес не установлен (.claude/.opencode/.agents нет) — проектные проверки пропущены"
  else
    # binding (только opencode: у claude/codex модели без провайдер-префикса — валидатор к ним не применим)
    if [ "$rn" = opencode ] && [ -f "$HOME_DIR/harness/validate-model-binding.mjs" ]; then
      b="$(node "$HOME_DIR/harness/validate-model-binding.mjs" opencode --brief 2>/dev/null | grep '^BINDING:')"
      case "$b" in
        "BINDING: ok") ok "модель-биндинг opencode: связка тир→провайдер цела" ;;
        "BINDING: fail"*) bad "модель-биндинг opencode: висячие ссылки (${b#BINDING: fail })" "node \"$HOME_DIR/harness/configure-models.mjs\" opencode  (или настрой провайдера в ~/.config/opencode)" ;;
      esac
    fi
    # симлинки проекта живые (не висячие)
    dead=""
    for d in "$adir" "$sdir" "$proj/harness"; do
      [ -L "$d" ] && [ ! -e "$d" ] && dead="$dead $d"
    done
    if [ -n "$dead" ]; then bad "висячие симлинки проекта:$dead" "переустанови: rationaldev install \"$proj\" $rn"
    else ok "симлинки проекта ($rn) живые (agents/skills/harness ведут в клон/проекции)"; fi
    # .claude/settings.json не разошёлся с эталоном (по маркеру управляемого блока)
    if [ "$rn" = claude ]; then
      sj="$proj/.claude/settings.json"
      if [ ! -f "$sj" ]; then echo "  · $sj нет (enforcement не установлен --hard?) — проверка проводки пропущена"
      elif node "$HOME_DIR/harness/merge-claude-settings.mjs" check "$sj" 2>/dev/null; then ok "settings.json: харнес-проводка на месте, не разошлась с эталоном"
      else bad "settings.json: проводка хуков разошлась/отсутствует" "переустанови --hard: rationaldev install \"$proj\" claude"; fi
    fi
  fi

  # PATH-проводка: rc обнаружённой оболочки содержит маркер (fish → fish_add_path) И `rationaldev` резолвится
  dsh="$(rd_detect_shell)"
  case "$dsh" in
    zsh)   rcs="${ZDOTDIR:-$HOME}/.zshrc"; pat="# rationaldev bin (bootstrap)" ;;
    bash)  rcs="$HOME/.bashrc $HOME/.bash_profile"; pat="# rationaldev bin (bootstrap)" ;;
    fish)  rcs="$HOME/.config/fish/config.fish"; pat="fish_add_path" ;;
    *)     rcs="$HOME/.profile"; pat="# rationaldev bin (bootstrap)" ;;
  esac
  found=0
  for rc in $rcs; do
    [ -f "$rc" ] && grep -qF "$pat" "$rc" 2>/dev/null && found=1
  done
  if [ "$found" = 1 ]; then ok "PATH-проводка ($dsh): маркер найден в rc"
  else bad "PATH-проводка ($dsh): маркера нет в rc ($rcs)" "перезапусти bootstrap: RATIONALDEV_SHELL=$dsh sh \"$HOME_DIR/bootstrap.sh\""; fi
  if command -v rationaldev >/dev/null 2>&1; then ok "команда rationaldev резолвится в PATH"
  else bad "rationaldev не резолвится в PATH (проводка есть, сессия не перечитала rc?)" "перезапусти оболочку ($dsh) или открой новый терминал"; fi

  echo
  if [ "$red" -eq 0 ]; then echo "doctor: всё зелёное."; else echo "doctor: $red красных пункт(ов) — см. команды починки выше."; exit 1; fi
}

case "${1:-help}" in
  update)              update ;;
  autocheck)           autocheck ;;
  install)             install_repo "${2:-}" "${3:-}" ;;
  doctor)              doctor "${2:-}" ;;
  help|-h|--help|"")   echo "usage: rationaldev <install <path> [runner] | update | autocheck | doctor [project-dir]>   # клон $HOME_DIR, канал $CHANNEL" ;;
  *)                   echo "rationaldev: неизвестная команда '$1' (есть: install, update, autocheck, doctor)"; exit 1 ;;
esac
